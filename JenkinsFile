pipeline {
    agent any 

    stages {
        stage('checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test - job service') {
            steps {
                dir('job-tracker/job-service') {
                    sh 'mvn test'
                }
            }
        }

        stage('Test - notification service') {
            steps {
                dir('job-tracker/notification-service') {
                    sh 'npm install'
                    sh 'npm test'
                }
            }
        }

        stage('Test - frontend') {
            steps {
                dir('job-tracker/frontend') {
                    sh 'npm install'
                    sh 'npm test'
                }
            }
        }

        // CORRECTED STAGE:
        // Added dir('job-tracker') so Jenkins finds your docker-compose.yml
        stage('build docker image') {
            steps {
                dir('job-tracker') {
                    sh 'docker compose build'
                }
            }
        }

        stage('deploy') {
            steps {
                echo 'deploying the application'
            }
        }
    }

    post {
        always {
            echo 'pipeline finished'
        }
        success {
            echo 'pipeline succeeded'
        }
        failure {
            echo 'pipeline failed check the logs above'
        }
    }
}